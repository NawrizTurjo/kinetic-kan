% ==============================================================================
% kinetic-kan.sty -- Executive Crimson report style (per report/design-red.md)
% Extracted so report.tex stays a thin document shell.
% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kinetic-kan}[2026/09/21 Executive Crimson report style]

% --- Geometry & base typography ---
\RequirePackage[margin=2.0cm, top=2.0cm, bottom=2.0cm]{geometry}
\RequirePackage{mathptmx}
\RequirePackage[scaled=0.90]{helvet}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{microtype}
\RequirePackage{parskip}
\setlength{\parskip}{3pt}
\raggedbottom
\setlength{\emergencystretch}{1.5em}

% --- Tables, lists, floats ---
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{ragged2e}
\RequirePackage{colortbl}
\RequirePackage{enumitem}
\setlist{nosep, leftmargin=1.4em}
\RequirePackage{float}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage[section]{placeins}

\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcommand{\thh}[1]{\textbf{\sffamily #1}}
\newcommand{\hdrrow}{\rowcolor{accentsoft}}

% --- Color palette ---
\RequirePackage{xcolor}
\definecolor{ink}{RGB}{28,32,38}
\definecolor{accent}{RGB}{155,26,32}
\definecolor{primary}{RGB}{155,26,32}
\definecolor{accentstrong}{RGB}{200,16,24}
\definecolor{accentsoft}{RGB}{247,228,229}
\definecolor{rule}{RGB}{209,213,219}
\definecolor{codebg}{RGB}{248,246,246}
\definecolor{hdrprimary}{RGB}{155,26,32}
\definecolor{darkslate}{RGB}{33,37,41}
\color{ink}

% --- Headings & captions ---
\RequirePackage{titlesec}
\titleformat{\section}
  {\sffamily\large\bfseries\color{accent}}
  {\thesection}{0.7em}{}[{\vspace{2pt}\color{rule}\titlerule[0.8pt]}]
\titleformat{\subsection}
  {\sffamily\normalsize\bfseries\color{ink}}
  {\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  {\sffamily\small\bfseries\color{ink}}
  {\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{16pt}{7pt}
\titlespacing*{\subsection}{0pt}{11pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

\captionsetup{labelfont={bf,sf,color=accent}, textfont={small}, labelsep=period, skip=6pt}

% --- Header / footer ---
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\pagestyle{fancy}
\setlength{\headheight}{15pt}
\fancyhf{}
\fancyhead[L]{\small\textbf{\color{primary}Kinetic-KAN} \ $\cdot$ \ {\color{primary!85}Project Final Report}}
\fancyhead[R]{\small\color{darkslate!80}KAN-ODE $\cdot$ Solver-Aware Neural Dynamics}
\fancyfoot[C]{\footnotesize\sffamily\color{ink}\thepage\ / \pageref{LastPage}}
\renewcommand{\headrulewidth}{0.75pt}
\renewcommand{\headrule}{%
  \vskip 2.5pt%
  {\color{primary!40}\hrule height \headrulewidth width \headwidth}%
  \vskip -\headrulewidth%
}

% --- Callouts, code, highlights ---
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{listings}

\newtcblisting{logbox}{
  breakable, enhanced, sharp corners,
  colback=codebg, colframe=rule, boxrule=0.5pt,
  left=8pt, right=8pt, top=6pt, bottom=6pt,
  listing only,
  listing options={
    basicstyle=\ttfamily\footnotesize\color{ink},
    breaklines=true, columns=fullflexible, keepspaces=true,
    aboveskip=0pt, belowskip=0pt}}

\newtcolorbox{keypoint}[1][Key finding]{
  enhanced, sharp corners,
  colback=accentsoft, colframe=accent, boxrule=0pt,
  leftrule=2.5pt, left=9pt, right=9pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{accent},
  title={#1}, coltitle=accent}

% Expected-vs-observed scaffold: placed at the top of each experiment,
% before any data, so a reader sees the question being tested before the
% numbers that answer it. Deliberately styled in neutral ink/grey rather
% than the crimson accent, so it reads as distinct from the crimson
% "Verdict" keypoint box closing each experiment.
\newenvironment{expectbox}{%
  \begin{tcolorbox}[enhanced, sharp corners,
    colback=codebg, colframe=ink!55, boxrule=0pt,
    leftrule=2.5pt, left=9pt, right=9pt, top=5pt, bottom=5pt]
  \footnotesize
  \begin{description}[style=sameline, leftmargin=2.05cm, labelwidth=1.9cm,
    labelsep=8pt, itemindent=0pt, topsep=1pt, itemsep=4pt, parsep=0pt]
}{%
  \end{description}
  \end{tcolorbox}
}
\newcommand{\expectrow}[2]{\item[\textbf{\sffamily\small\color{ink}#1}] #2}

\newcommand{\hl}[1]{\textbf{\color{accentstrong}#1}}

% --- Math shorthands used across sections (kept modest, not decorative) ---
\RequirePackage{amsmath, amssymb}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\Ltrunc}{L}          % Lipschitz-constant symbol, per docs/09
\newcommand{\Ttrain}{T}          % training-window horizon symbol

% --- Pseudocode (Algorithms in the numerical-implementation section) ---
\RequirePackage{algorithm}
\RequirePackage[noend]{algpseudocode}
\algrenewcommand\algorithmicrequire{\textbf{Input:}}
\algrenewcommand\algorithmicensure{\textbf{Output:}}
\floatname{algorithm}{Algorithm}

\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, calc, fit, backgrounds}
\RequirePackage{url}
\Urlmuskip=0mu plus 1mu
\renewcommand{\UrlFont}{\ttfamily\small}
\RequirePackage[numbers]{natbib}
\RequirePackage[hidelinks]{hyperref}

