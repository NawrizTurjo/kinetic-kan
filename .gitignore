# Keep the small (~10 KB) benchmark checkpoints: a 10,000-epoch sweep costs hours of
# compute, and Phase 3 (SINDy / pruning / Lorenz) needs trained weights to start from.
!implementation/results/**/best_model.pt
!implementation/results/**/final_model.pt

# Track D checkpoints (~4.7KB each, 73 total, ~584KB) -- backs the f_theta
# equilibrium claims (docs/16 sec 3) and the loss-landscape analysis (sec 8)
!implementation/results/phase3/stiffness_map/**/checkpoint.pt

